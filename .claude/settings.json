{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(graphify *)",
      "Bash(ls *)",
      "Bash(diff *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(uv run pytest*)",
      "PowerShell(uv run ruff *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)",
      "Bash(ollama pull *)",
      "Bash(rm -rf *)",
      "PowerShell(git push*)",
      "PowerShell(git merge *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(uv add *)",
      "PowerShell(pip install *)",
      "PowerShell(ollama pull *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./data/real/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/luisr/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/luisr/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/luisr/.local/bin/graphify.EXE hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}